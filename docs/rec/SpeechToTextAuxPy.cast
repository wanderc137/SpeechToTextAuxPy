[78.466, "o", "\u001b[90m┌─ sapi_engine.py · start() ────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[78.466, "o", "\u001b[90m 147\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mstart\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[78.521, "o", "\u001b[90m 148\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[78.576, "o", "\u001b[90m 149\u001b[0m\u001b[90m │ \u001b[0m        Inicia el reconocimiento de voz asíncrono continuo.\u001b[90m\u001b[39;49;00m\n"]
[78.631, "o", "\u001b[90m 150\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[78.686, "o", "\u001b[90m 151\u001b[0m\u001b[90m │ \u001b[0m        El motor comienza a escuchar el dispositivo de entrada predeterminado\u001b[90m\u001b[39;49;00m\n"]
[78.741, "o", "\u001b[90m 152\u001b[0m\u001b[90m │ \u001b[0m        y dispara eventos SpeechRecognized cuando detecta voz.\u001b[90m\u001b[39;49;00m\n"]
[78.796, "o", "\u001b[90m 153\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[78.851, "o", "\u001b[90m 154\u001b[0m\u001b[90m │ \u001b[0m        Reconoce múltiples frases de forma continua (RecognizeMode.Multiple)\u001b[90m\u001b[39;49;00m\n"]
[78.906, "o", "\u001b[90m 155\u001b[0m\u001b[90m │ \u001b[0m        hasta que se llame a stop() o se cancele explícitamente.\u001b[90m\u001b[39;49;00m\n"]
[78.961, "o", "\u001b[90m 156\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[79.016, "o", "\u001b[90m 157\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m._engine \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[79.071, "o", "\u001b[90m 158\u001b[0m\u001b[90m │ \u001b[0m            console_utils.print_error(\u001b[33m\"\u001b[39;49;00m\u001b[33mEl motor SAPI no está inicializado.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[79.126, "o", "\u001b[90m 159\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[79.181, "o", "\u001b[90m 160\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
