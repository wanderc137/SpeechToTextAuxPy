[25.053, "o", "\u001b[90m┌─ main.py · main() ────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[25.053, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mmain\u001b[39;49;00m() -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[25.108, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[25.163, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m    Función principal \u001b[94mdel\u001b[39;49;00m programa.\u001b[90m\u001b[39;49;00m\n"]
[25.218, "o", "\u001b[90m  71\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[25.273, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m    Realiza las siguientes operaciones:\u001b[90m\u001b[39;49;00m\n"]
[25.328, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94m1.\u001b[39;49;00m Registra el manejador de Ctrl+C\u001b[90m\u001b[39;49;00m\n"]
[25.383, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94m2.\u001b[39;49;00m Crea la instancia de SapiEngine con idioma español\u001b[90m\u001b[39;49;00m\n"]
[25.438, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94m3.\u001b[39;49;00m Inicia el reconocimiento de voz\u001b[90m\u001b[39;49;00m\n"]
[25.493, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94m4.\u001b[39;49;00m Mantiene el programa ejecutándose hasta Ctrl+C\u001b[90m\u001b[39;49;00m\n"]
[25.548, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[25.603, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mglobal\u001b[39;49;00m _engine\u001b[90m\u001b[39;49;00m\n"]
[25.658, "o", "\u001b[90m  79\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[25.713, "o", "\u001b[90m  80\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Registrar manejadores de señales\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[25.768, "o", "\u001b[90m  81\u001b[0m\u001b[90m │ \u001b[0m    signal.signal(signal.SIGINT, signal_handler)\u001b[90m\u001b[39;49;00m\n"]
[25.823, "o", "\u001b[90m  82\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# SIGTERM no es común en Windows nativo, pero mejora compatibilidad\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[25.878, "o", "\u001b[90m  83\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# con entornos como WSL, Cygwin o gestores de procesos\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[25.933, "o", "\u001b[90m  84\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[25.988, "o", "\u001b[90m  85\u001b[0m\u001b[90m │ \u001b[0m        signal.signal(signal.SIGTERM, signal_handler)\u001b[90m\u001b[39;49;00m\n"]
[26.043, "o", "\u001b[90m  86\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexcept\u001b[39;49;00m \u001b[96mAttributeError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[26.098, "o", "\u001b[90m  87\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mpass\u001b[39;49;00m  \u001b[90m# SIGTERM no disponible en algunas versiones de Windows\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[26.153, "o", "\u001b[90m  88\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
