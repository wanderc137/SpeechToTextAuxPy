[129.851, "o", "\u001b[90m 102\u001b[0m\u001b[90m │ \u001b[0m                console_utils.print_error(\u001b[90m\u001b[39;49;00m\n"]
[129.906, "o", "\u001b[90m 103\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mEl idioma \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mlanguage\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m no está soportado. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[129.961, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mAsegúrate de tener instalado el paquete de voz en español.\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[130.016, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m   -> Configuración > Hora e idioma > Voz > Agregar voz\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
