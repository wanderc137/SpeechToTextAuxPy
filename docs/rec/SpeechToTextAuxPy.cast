[91.59, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[91.645, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m            _engine.stop()\u001b[90m\u001b[39;49;00m\n"]
[91.7, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m \u001b[94mas\u001b[39;49;00m e:\u001b[90m\u001b[39;49;00m\n"]
[91.755, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m            console_utils.print_error(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mError al detener el motor: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00me\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
