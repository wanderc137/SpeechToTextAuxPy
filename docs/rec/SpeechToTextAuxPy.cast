[103.031, "o", "\u001b[90m┌─ sapi_engine.py · stop() ─────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[103.031, "o", "\u001b[90m 173\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mstop\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[103.086, "o", "\u001b[90m 174\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[103.141, "o", "\u001b[90m 175\u001b[0m\u001b[90m │ \u001b[0m        Detiene el reconocimiento de voz y libera recursos.\u001b[90m\u001b[39;49;00m\n"]
[103.196, "o", "\u001b[90m 176\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[103.251, "o", "\u001b[90m 177\u001b[0m\u001b[90m │ \u001b[0m        Cancela el reconocimiento asíncrono y libera el motor SAPI\u001b[90m\u001b[39;49;00m\n"]
[103.306, "o", "\u001b[90m 178\u001b[0m\u001b[90m │ \u001b[0m        y la gramática asociada. Es seguro llamarlo múltiples veces.\u001b[90m\u001b[39;49;00m\n"]
[103.361, "o", "\u001b[90m 179\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[103.416, "o", "\u001b[90m 180\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m._engine \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[103.471, "o", "\u001b[90m 181\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[103.526, "o", "\u001b[90m 182\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# Cancelar reconocimiento asíncrono\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[103.581, "o", "\u001b[90m 183\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m._engine.RecognizeAsyncCancel()\u001b[90m\u001b[39;49;00m\n"]
[103.636, "o", "\u001b[90m 184\u001b[0m\u001b[90m │ \u001b[0m                console_utils.print_info(\u001b[33m\"\u001b[39;49;00m\u001b[33mReconocimiento de voz detenido.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[103.691, "o", "\u001b[90m 185\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m \u001b[94mas\u001b[39;49;00m e:\u001b[90m\u001b[39;49;00m\n"]
[103.746, "o", "\u001b[90m 186\u001b[0m\u001b[90m │ \u001b[0m                console_utils.print_error(\u001b[90m\u001b[39;49;00m\n"]
[103.801, "o", "\u001b[90m 187\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mError al cancelar reconocimiento: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00me\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[103.856, "o", "\u001b[90m 188\u001b[0m\u001b[90m │ \u001b[0m                )\u001b[90m\u001b[39;49;00m\n"]
[103.911, "o", "\u001b[90m 189\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
