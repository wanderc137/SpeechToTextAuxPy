[129.741, "o", "\u001b[90m 100\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Detectar errores comunes y dar mensajes útiles\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
