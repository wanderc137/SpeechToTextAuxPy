[51.423, "o", "\u001b[90m┌─ sapi_engine.py · motor y gramática ──────────────────────────────────────────────────────────────────\u001b[0m\n"]
[51.423, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Crear CultureInfo para el idioma solicitado\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[51.478, "o", "\u001b[90m  79\u001b[0m\u001b[90m │ \u001b[0m            cultura = CultureInfo(language)\u001b[90m\u001b[39;49;00m\n"]
[51.533, "o", "\u001b[90m  80\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[51.588, "o", "\u001b[90m  81\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Crear el motor de reconocimiento\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[51.643, "o", "\u001b[90m  82\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mself\u001b[39;49;00m._engine = SpeechRecognitionEngine(cultura)\u001b[90m\u001b[39;49;00m\n"]
[51.698, "o", "\u001b[90m  83\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[51.753, "o", "\u001b[90m  84\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Configurar entrada desde el dispositivo de audio predeterminado\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[51.808, "o", "\u001b[90m  85\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mself\u001b[39;49;00m._engine.SetInputToDefaultAudioDevice()\u001b[90m\u001b[39;49;00m\n"]
[51.863, "o", "\u001b[90m  86\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[51.918, "o", "\u001b[90m  87\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Cargar gramática de dictado (reconocimiento de texto libre)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[51.973, "o", "\u001b[90m  88\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mself\u001b[39;49;00m._grammar = DictationGrammar()\u001b[90m\u001b[39;49;00m\n"]
[52.028, "o", "\u001b[90m  89\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mself\u001b[39;49;00m._engine.LoadGrammar(\u001b[96mself\u001b[39;49;00m._grammar)\u001b[90m\u001b[39;49;00m\n"]
[52.083, "o", "\u001b[90m  90\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[52.138, "o", "\u001b[90m  91\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Registrar el evento de reconocimiento\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[52.193, "o", "\u001b[90m  92\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mself\u001b[39;49;00m._engine.SpeechRecognized += \u001b[96mself\u001b[39;49;00m._on_speech_recognized\u001b[90m\u001b[39;49;00m\n"]
