[117.975, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m        text: Texto reconocido por el motor SAPI.\u001b[90m\u001b[39;49;00m\n"]
[118.03, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[118.085, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m    reset = Style.RESET_ALL \u001b[94mif\u001b[39;49;00m COLORAMA_DISPONIBLE \u001b[94melse\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[118.14, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m    bright = Style.BRIGHT \u001b[94mif\u001b[39;49;00m COLORAMA_DISPONIBLE \u001b[94melse\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[118.195, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m    print_timestamp(color=Fore.CYAN, stream=sys.stdout)\u001b[90m\u001b[39;49;00m\n"]
