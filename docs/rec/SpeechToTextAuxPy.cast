[117.535, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mprint_recognized\u001b[39;49;00m(text: \u001b[96mstr\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
