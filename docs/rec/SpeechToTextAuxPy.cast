[117.755, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m    Formato: [HH:MM:SS] texto reconocido\u001b[90m\u001b[39;49;00m\n"]
[117.81, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m    El timestamp aparece en cian y el texto en blanco brillante.\u001b[90m\u001b[39;49;00m\n"]
