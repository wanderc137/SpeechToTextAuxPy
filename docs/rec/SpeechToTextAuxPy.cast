[65.074, "o", "\u001b[90m┌─ sapi_engine.py · _on_speech_recognized() ────────────────────────────────────────────────────────────\u001b[0m\n"]
[65.074, "o", "\u001b[90m 121\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_on_speech_recognized\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, sender: Any, args: Any) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[65.129, "o", "\u001b[90m 122\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[65.184, "o", "\u001b[90m 123\u001b[0m\u001b[90m │ \u001b[0m        Callback ejecutado cuando SAPI reconoce una frase.\u001b[90m\u001b[39;49;00m\n"]
[65.239, "o", "\u001b[90m 124\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[65.294, "o", "\u001b[90m 125\u001b[0m\u001b[90m │ \u001b[0m        Este método es registrado como delegado \u001b[94mdel\u001b[39;49;00m evento SpeechRecognized.\u001b[90m\u001b[39;49;00m\n"]
[65.349, "o", "\u001b[90m 126\u001b[0m\u001b[90m │ \u001b[0m        Obtiene el texto reconocido y lo envía a la consola.\u001b[90m\u001b[39;49;00m\n"]
[65.404, "o", "\u001b[90m 127\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[65.459, "o", "\u001b[90m 128\u001b[0m\u001b[90m │ \u001b[0m        Args:\u001b[90m\u001b[39;49;00m\n"]
[65.514, "o", "\u001b[90m 129\u001b[0m\u001b[90m │ \u001b[0m            sender: Objeto que disparó el evento (SpeechRecognitionEngine).\u001b[90m\u001b[39;49;00m\n"]
[65.569, "o", "\u001b[90m 130\u001b[0m\u001b[90m │ \u001b[0m            args: Argumentos \u001b[94mdel\u001b[39;49;00m evento (SpeechRecognizedEventArgs).\u001b[90m\u001b[39;49;00m\n"]
[65.624, "o", "\u001b[90m 131\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[65.679, "o", "\u001b[90m 132\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[65.734, "o", "\u001b[90m 133\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m args \u001b[95mand\u001b[39;49;00m args.Result \u001b[95mand\u001b[39;49;00m args.Result.Text:\u001b[90m\u001b[39;49;00m\n"]
[65.789, "o", "\u001b[90m 134\u001b[0m\u001b[90m │ \u001b[0m                texto = args.Result.Text.strip()\u001b[90m\u001b[39;49;00m\n"]
[65.844, "o", "\u001b[90m 135\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mif\u001b[39;49;00m texto:\u001b[90m\u001b[39;49;00m\n"]
[65.899, "o", "\u001b[90m 136\u001b[0m\u001b[90m │ \u001b[0m                    console_utils.print_recognized(texto)\u001b[90m\u001b[39;49;00m\n"]
[65.954, "o", "\u001b[90m 137\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[66.009, "o", "\u001b[90m 138\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# Liberar recursos del resultado\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[66.064, "o", "\u001b[90m 139\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m args \u001b[95mand\u001b[39;49;00m args.Result:\u001b[90m\u001b[39;49;00m\n"]
[66.119, "o", "\u001b[90m 140\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
