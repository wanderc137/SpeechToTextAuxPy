[90.765, "o", "\u001b[90m┌─ main.py · signal_handler() ──────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[90.765, "o", "\u001b[90m  44\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msignal_handler\u001b[39;49;00m(signal_num: \u001b[96mint\u001b[39;49;00m, frame) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[90.82, "o", "\u001b[90m  45\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[90.875, "o", "\u001b[90m  46\u001b[0m\u001b[90m │ \u001b[0m    Manejador de señales para Ctrl+C (SIGINT).\u001b[90m\u001b[39;49;00m\n"]
[90.93, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[90.985, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m    Detiene el motor SAPI y termina el programa de forma limpia.\u001b[90m\u001b[39;49;00m\n"]
[91.04, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[91.095, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m    Args:\u001b[90m\u001b[39;49;00m\n"]
[91.15, "o", "\u001b[90m  51\u001b[0m\u001b[90m │ \u001b[0m        signal_num: Número de señal recibida.\u001b[90m\u001b[39;49;00m\n"]
[91.205, "o", "\u001b[90m  52\u001b[0m\u001b[90m │ \u001b[0m        frame: Frame de ejecución actual (no usado).\u001b[90m\u001b[39;49;00m\n"]
[91.26, "o", "\u001b[90m  53\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[91.315, "o", "\u001b[90m  54\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mglobal\u001b[39;49;00m _engine\u001b[90m\u001b[39;49;00m\n"]
[91.37, "o", "\u001b[90m  55\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[91.425, "o", "\u001b[90m  56\u001b[0m\u001b[90m │ \u001b[0m    console_utils.print_info(\u001b[33m\"\u001b[39;49;00m\u001b[33mCtrl+C recibido. Deteniendo...\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[91.48, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
