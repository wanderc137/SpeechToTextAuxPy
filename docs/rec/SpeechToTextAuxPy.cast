[79.346, "o", "\u001b[90m 163\u001b[0m\u001b[90m │ \u001b[0m            console_utils.print_info(\u001b[90m\u001b[39;49;00m\n"]
[79.401, "o", "\u001b[90m 164\u001b[0m\u001b[90m │ \u001b[0m                \u001b[33m\"\u001b[39;49;00m\u001b[33mIniciando reconocimiento de voz en español...\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
